<!DOCTYPE html>
<html>

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Status</title>
</head>

<body>
    <p>
        {{#if lastDate}}
        Last seen <span id="mins"></span> minute(s) ago, at <span id="time"></span>
        {{else}}
        Probably offline, seen &gt;15 minutes ago
        {{/if}}
    </p>
    {{#if statusMessage}}
    <p>{{statusMessage}}</p>
    {{/if}}
    {{#if lastDate}}
    <script>
        const lastDate = '{{lastDate}}';
        const date = new Date(Date.parse(lastDate));
        const diff = Math.round((new Date().getTime() - date.getTime()) / 1000 / 60);
        document.getElementById('mins').textContent = diff;
        document.getElementById('time').textContent = date.toLocaleString();
    </script>
    {{/if}}
</body>

</html>